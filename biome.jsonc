{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Ultracite 7 ships oxlint/oxfmt by default; its Biome presets live under
  // `ultracite/biome/*`. `core` is the base ruleset, `vitest` adds test-file
  // rules (no focused/skipped tests, no assertions outside `it`).
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "!!**/node_modules",
      "!!**/.turbo",
      "!!**/.next",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/coverage",
      "!!**/drizzle",
      "!!**/bun.lock",
      // Biome's CSS parser does not know Tailwind v4's at-rules (@theme,
      // @source, @custom-variant, @apply) and fails to parse these files.
      // Parsing precedes linting, so an override cannot silence it -- the
      // entry points have to be excluded outright. Tailwind itself validates
      // them at build time.
      "!**/globals.css",
      // Kept byte-identical to what `auth:generate` emits, so that upgrading
      // Better Auth produces a reviewable diff instead of a formatting one.
      "!**/schema/generated"
    ]
  },
  "javascript": {
    // Biome recognises browser and Node globals, not Bun's. `Bun.spawn`,
    // `Bun.stdin` and `Bun.file` are the runtime here, and without this every
    // use is reported as an undeclared variable.
    "globals": ["Bun"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "rules": {
      "suspicious": {
        /*
         * Biome's type-aware rule, and it costs the entire lint budget.
         *
         * Measured: 75s on `apps/server/src/plugins/auth.ts` -- a 20-line file
         * -- because the rule resolves types across the whole import graph,
         * down into better-auth's and Elysia's declaration files. With it on,
         * `bun run lint` takes ~100s; with it off, ~2s. It also runs in the
         * pre-commit hook, so staging one of those files cost a minute-long
         * commit.
         *
         * Against that: zero findings across all 108 files in the repo.
         *
         * Re-enable it per package if you want it somewhere that does not
         * import a large SDK -- the cost is concentrated in the files that do.
         */
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // The bucket walk is sequential by nature: each iteration decides whether
      // to continue from the rows the previous one returned, and stops as soon
      // as it has enough. Running the queries in parallel would issue reads for
      // partitions the walk was about to skip.
      "includes": ["packages/chat-db/src/**"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      // Two sequential-by-nature loops. The rate-limit integration test
      // asserts the budget counts DOWN, which only means something one take at
      // a time; the e2e harness polls for a condition, which is what polling
      // is. Neither has anything to parallelise.
      "includes": [
        "packages/kv/tests/integration/**",
        "apps/server/tests/e2e/harness.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      // The validation hook runs lint, check-types, test and audit in order and
      // stops reporting at the first blocking failure. In parallel they would
      // be four turbo processes contending for one cache and one daemon, and
      // the interleaved output would be unreadable -- which defeats a hook
      // whose entire product is a legible error message.
      "includes": [".claude/hooks/**"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    },
    {
      // Redis Cluster picks a slot with CRC16/XMODEM, which is shifts and XORs
      // all the way down. The rule is aimed at `&` written where `&&` was
      // meant; a checksum is the case it is not aimed at. This test
      // reimplements the real slot function so the hash-tag co-location the
      // whole key scheme depends on is computed rather than asserted.
      "includes": ["packages/kv/tests/unit/keys.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      // The whole module is the point: `mock.module` in Bun is process-global,
      // so this file's mock of @repo/kv also applies to every other test file
      // in the run. Spreading the real namespace over the overrides keeps the
      // exports it does not stub -- notably `subscribeEvents`, which
      // gateway-registry.test.ts needs -- instead of erasing them.
      "includes": [
        "apps/server/tests/unit/gateway-handlers.test.ts",
        "apps/server/tests/e2e/gateway.test.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      // Drizzle requires the schema namespace object -- `drizzle(pool, { schema })`
      // is what enables relational queries.
      "includes": ["packages/db/**"],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      // These barrels are the packages' declared public entry points (each one
      // is named in its package.json `exports`), and `packages/db/src/schema`
      // is the single file `drizzle.config.ts` reads. noBarrelFile targets
      // incidental re-export hubs inside app code, not package boundaries.
      "includes": [
        "packages/db/src/index.ts",
        "packages/db/src/schema/index.ts",
        "packages/db/src/validation/index.ts",
        "packages/ui/src/components/index.ts",
        "packages/ui/src/lib/index.ts",
        "packages/chat-db/src/index.ts",
        "packages/kv/src/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
