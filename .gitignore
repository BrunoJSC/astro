.turbo/
.turbo-cookie

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# Anchored to workspace roots: bare `dist/`, `build/`, `out/` and `lib/` match
# at ANY depth, which would silently swallow source dirs like
# `apps/web/src/lib/` or an app route named `build`.
apps/*/dist/
apps/*/build/
apps/*/out/
apps/*/.output/
packages/*/dist/
packages/*/build/
packages/*/out/
/dist/
/build/
/out/
*.tsbuildinfo
.tsbuildinfo/

# ---------------------------------------------------------------------------
# Next.js
# ---------------------------------------------------------------------------
.next/
.vercel/
next-env.d.ts
.swc/

# ---------------------------------------------------------------------------
# Expo / React Native
# ---------------------------------------------------------------------------
.expo/
.expo-shared/
expo-env.d.ts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
# Native folders are generated by `expo prebuild` (CNG). Remove these two
# lines if you switch to a bare workflow and commit them.
apps/native/android/
apps/native/ios/
.metro-health-check*
.gradle/
local.properties
*.hprof
.kotlin/
.cxx/
*.keystore
!debug.keystore
DerivedData/
Pods/
*.xcworkspace
!default.xcworkspace
.xcode.env.local

# ---------------------------------------------------------------------------
# Tauri (desktop)
# ---------------------------------------------------------------------------
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
target/
**/*.rs.bk
*.pdb
.cargo/

# ---------------------------------------------------------------------------
