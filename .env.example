# ---------------------------------------------------------------------------
# Reference: every variable @repo/env validates, in one place.
#
# Copying this to a root `.env` does NOT configure the workspace tasks. Bun
# reads `.env` from the current directory only -- it does not walk up -- and
# `turbo` runs in strict env mode, so a task only receives the variables its
# `env` array in turbo.json declares. Each app and package therefore keeps its
# own `.env`, loaded by its own tool (Bun, Next, Expo, drizzle-kit) after turbo
# has already spawned it.
#
# A root `.env` is still useful for commands run from the repo root, and is
# listed in turbo.json's `globalDependencies` so changing it busts the cache.
#
# Copy the per-directory files instead:
#   cp apps/server/.env.example   apps/server/.env
#   cp apps/web/.env.example      apps/web/.env
#   cp apps/native/.env.example   apps/native/.env
#   cp packages/db/.env.example   packages/db/.env
#   cp packages/auth/.env.example packages/auth/.env
#   cp apps/desktop/.env.example  apps/desktop/.env
# ---------------------------------------------------------------------------

# --- shared (@repo/env/shared) ---------------------------------------------
# development | test | production. Defaults to "development".
NODE_ENV=development

# --- server (@repo/env/server) ---------------------------------------------
# Required. Any Postgres URL. For Neon, use the POOLED endpoint and keep
# `?sslmode=require` -- node-postgres does not enable TLS on its own.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astro

# Required, minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-thirty-two-characters

# Direct connection to the primary compute, bypassing the pooler. Only
# drizzle-kit uses it (db:migrate, db:push): Neon's pooler runs PgBouncer in
# transaction mode, where DDL and advisory locks do not behave. Optional --
# falls back to DATABASE_URL on a plain Postgres, which has no pooler.
DIRECT_URL=postgres://postgres:postgres@localhost:5432/astro

# Required. Origin Better Auth issues cookies and callbacks for.
BETTER_AUTH_URL=http://localhost:3001

# Optional, defaults to 3001. Port the Elysia API binds to.
PORT=3001

# Optional, defaults to redis://localhost:6379. Redis or Valkey, read by
# @repo/kv for presence, typing, voice state and the WebSocket fan-out.
# `rediss://` for anything not on localhost.
REDIS_URL=redis://localhost:6379

# Optional, defaults to http://localhost:3000. Comma-separated CORS allowlist.
# Never a wildcard: `credentials: true` and `*` cannot be combined.
# 5173 is the Electron renderer's dev server.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- web client (@repo/env/client) -----------------------------------------
# Required. Inlined into the browser bundle at build time -- public by design.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- native client (@repo/env/native) --------------------------------------
# Required. Inlined by Metro at build time.
EXPO_PUBLIC_API_URL=http://localhost:3001

# --- desktop client (@repo/env/desktop) ------------------------------------
# Required. Inlined by Vite at build time, and read by Electron's main process
# to build the renderer's CSP.
VITE_API_URL=http://localhost:3001

# --- escape hatch ----------------------------------------------------------
# Skips every T3 Env check. Only for CI steps that build without real secrets
# (a lint or type-check job); never set it where the app actually runs.
# SKIP_ENV_VALIDATION=1
