# Next.js app. Loaded by Next from this directory.
#
# Two sets of variables, validated at two different moments:
#
#   NEXT_PUBLIC_*  -> @repo/env/client, inlined into the browser bundle.
#   the rest       -> @repo/env/server, validated twice: in next.config.ts at
#                     BUILD time (against CI's environment) and again in
#                     instrumentation.ts at server BOOT (against production's).
#
# Anything prefixed NEXT_PUBLIC_ ships to the browser. Never put a secret here.

# --- public (browser) ---
# Required. Where the Elysia API answers.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional. This app's own public origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- server-only ---
# Required. Read by @repo/db, which this app pulls in through @repo/auth.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astro

# Required, minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-thirty-two-characters

# Required.
BETTER_AUTH_URL=http://localhost:3001
