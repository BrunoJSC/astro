# Expo app. Loaded by Expo from this directory.
#
# Validated in two places: app.config.ts evaluates @repo/env/native in Node
# before bundling, so a bad value fails `expo export` / `expo start` outright;
# the same module then runs inside the bundle at app startup.
#
# EXPO_PUBLIC_* is inlined by Metro at build time and ships in the binary --
# public by design, never a secret. Changing it needs a bundler restart, not
# just a reload.

# Required. Where the Elysia API answers. On a physical device, localhost is
# the device itself: use the host machine's LAN address instead.
EXPO_PUBLIC_API_URL=http://localhost:3001
