{
  "extends": "@repo/config/react-library.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    /*
     * The main and preload processes run in Node, the renderer in Chromium, so
     * both sets of globals have to be visible. `vite/client` is what declares
     * the CSS and asset imports the renderer makes; `electron-vite/node` adds
     * the main-process side of `import.meta.env`. Neither covers the other.
     */
    "types": ["node", "vite/client", "electron-vite/node"],
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "electron", "tests", "electron.vite.config.ts"],
  "exclude": ["node_modules", "dist", "out", ".turbo"]
}
