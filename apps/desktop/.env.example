# Electron desktop app. Loaded by electron-vite from this directory.
#
# Only VITE_* reaches the app -- that prefix is what Vite inlines, and the
# validation in src/env.ts runs against exactly these keys.
#
# Everything here ships inside the installer and can be read by anyone who
# unpacks it. A desktop build is a directory on the user's disk. Never put a
# secret in this file.

# Required. Where the Elysia API answers.
#
# Absolute, always: a packaged renderer is loaded from file://, whose origin is
# opaque, so a relative URL would resolve against the bundle rather than the API.
# The main process also reads this to build the CSP's connect-src.
VITE_API_URL=http://localhost:3001

# Optional escape hatch, mirrors SKIP_ENV_VALIDATION elsewhere in the repo.
# VITE_SKIP_ENV_VALIDATION=1
