# Elysia API. Loaded by Bun from this directory when `bun src/index.ts` runs,
# which is what makes it work under `turbo run dev` -- turbo's strict env mode
# would otherwise filter these out before the process starts.
#
# Validated by @repo/env/server at import time: a bad value stops the server
# on boot, with the offending key named.

# Required. For Neon, use the pooled endpoint with ?sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astro

# Required, minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-thirty-two-characters

# Direct connection to the primary compute, bypassing the pooler. Only
# drizzle-kit uses it (db:migrate, db:push): Neon's pooler runs PgBouncer in
# transaction mode, where DDL and advisory locks do not behave. Optional --
# falls back to DATABASE_URL on a plain Postgres, which has no pooler.
DIRECT_URL=postgres://postgres:postgres@localhost:5432/astro

# Required. Must match where this API is reachable, since Better Auth signs
# its cookies and OAuth callbacks against it.
BETTER_AUTH_URL=http://localhost:3001

# Optional, defaults to 3001.
PORT=3001

# Optional, defaults to http://localhost:3000. Comma-separated.
# Add every origin that calls this API with credentials: the web app on 3000,
# and the desktop app, which needs THREE entries for one client.
#
# http://localhost:1420 is only what Vite serves during `tauri dev`. A packaged
# build never loads it -- the window is served from the custom protocol, which
# spells its origin differently per platform: tauri://localhost on macOS and
# Linux, http://tauri.localhost on Windows. Omitting the last two produces an
# app that works all through development and fails on the first machine that
# installs it.
CORS_ORIGINS=http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost
