{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design system: Base UI primitives, shadcn-style variants, Tailwind tokens",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib": "./src/lib/index.ts",
    "./styles": "./src/styles/globals.css",
    "./tailwind.config": "./tailwind.config.ts"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules coverage *.tsbuildinfo",
    "test": "bun run test:unit && bun run test:e2e",
    "test:e2e": "bun test tests/e2e",
    "test:unit": "bun test tests/unit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:ui",
    "@shadcn/react": "catalog:ui",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "cmdk": "catalog:ui",
    "cn": "^0.2.6",
    "lucide-react": "catalog:ui",
    "tailwind-merge": "catalog:ui"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@tailwindcss/postcss": "catalog:ui",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "catalog:ui",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:ui",
    "tw-animate-css": "catalog:ui",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:ui"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
