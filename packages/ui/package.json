{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design system: Base UI primitives, shadcn-style variants, Tailwind tokens",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib": "./src/lib/index.ts",
    "./styles": "./src/styles/globals.css",
    "./tailwind.config": "./tailwind.config.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules coverage *.tsbuildinfo",
    "test": "bun test tests/unit",
    "test:unit": "bun test tests/unit"
  },
  "dependencies": {
    "@base-ui-components/react": "catalog:ui",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "tailwind-merge": "catalog:ui"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:ui",
    "tw-animate-css": "catalog:ui",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:ui"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
