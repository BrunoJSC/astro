{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  // The design system is React too, but framework-agnostic: the React preset
  // applies, the Next one does not.
  "root": false,
  "extends": ["../../biome.jsonc", "ultracite/biome/react"],
  // Without this the inherited `files.includes` from the root config are
  // re-resolved against this directory and exclude everything -- Biome then
  // reports "Checked 0 files" and the whole package silently stops being linted.
  // The Tailwind entry point is excluded here too: a nested `includes`
  // replaces the inherited one rather than merging with it, so the root
  // config's exclusion does not carry down.
  "files": { "includes": ["**", "!**/globals.css"] }
}
