{
  "name": "@repo/chat-db",
  "version": "0.0.0",
  "private": true,
  "description": "ScyllaDB message history, audit and moderation logs",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./buckets": "./src/buckets.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules *.tsbuildinfo",
    "scylla:cqlsh": "docker compose exec scylla cqlsh",
    "scylla:down": "docker compose down -v",
    "scylla:up": "docker compose up -d --wait",
    "test": "bun test tests/unit",
    "test:unit": "bun test tests/unit",
    "validate:cql": "./scripts/validate.sh"
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "cassandra-driver": "catalog:chat"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
