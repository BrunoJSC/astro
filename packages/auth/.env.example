# Needed by `bun run auth:generate`, which runs the Better Auth CLI against
# src/server.ts -- that module imports @repo/env/server, so the whole server
# schema has to validate before the generator can read the auth config.
#
# The test suite does not use this file: tests/setup.ts seeds its own values.

# Required, minimum 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-thirty-two-characters

# Required.
BETTER_AUTH_URL=http://localhost:3001

# Required. The generator inspects the Drizzle adapter, which builds a client
# from this URL -- it does not connect unless you also run the migration.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astro
