# drizzle-kit runs with this directory as its working directory (`db:generate`,
# `db:migrate`, `db:push`, `db:studio`), and Bun loads `.env` from the current
# directory only -- it does not walk up to the repo root. Without this file the
# migration commands see no DATABASE_URL, whatever the shell exports, because
# turbo's strict env mode filters what reaches the task.
#
# drizzle.config.ts reads it through @repo/env/server, so the same validation
# applies here as at runtime.

# Required. Point at the database the migrations should be applied to --
# double-check this is not production before running db:push.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/astro

# Required by @repo/env/server's schema even though drizzle-kit never uses
# them: the module validates every server key as a unit.
BETTER_AUTH_SECRET=replace-me-with-at-least-thirty-two-characters

# Direct connection to the primary compute, bypassing the pooler. Only
# drizzle-kit uses it (db:migrate, db:push): Neon's pooler runs PgBouncer in
# transaction mode, where DDL and advisory locks do not behave. Optional --
# falls back to DATABASE_URL on a plain Postgres, which has no pooler.
DIRECT_URL=postgres://postgres:postgres@localhost:5432/astro
BETTER_AUTH_URL=http://localhost:3001
